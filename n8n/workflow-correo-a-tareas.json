{
  "name": "P08 correo a tareas (aprobacion humana obligatoria)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "p08-entrada",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "0b1f4c0e-0001-4a00-9000-000000000001",
      "name": "Entrada formulario o correo de prueba",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 200],
      "webhookId": "p08-entrada",
      "credentials": {
        "httpHeaderAuth": { "id": "REEMPLAZAR_EN_N8N", "name": "P08 entrada (header auth)" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "message_id", "value": "={{ $json.body.message_id }}", "type": "string" },
            { "id": "a2", "name": "from_email", "value": "={{ $json.body.from_email }}", "type": "string" },
            { "id": "a3", "name": "from_name", "value": "={{ $json.body.from_name ?? '' }}", "type": "string" },
            { "id": "a4", "name": "subject", "value": "={{ $json.body.subject }}", "type": "string" },
            { "id": "a5", "name": "body", "value": "={{ $json.body.body }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "0b1f4c0e-0002-4a00-9000-000000000002",
      "name": "Normalizar campos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3180/webhook/mail",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": { "timeout": 30000, "response": { "response": { "neverError": true, "fullResponse": false } } }
      },
      "id": "0b1f4c0e-0003-4a00-9000-000000000003",
      "name": "Nucleo P08: clasificar, borrador, tarea, aviso Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 200],
      "credentials": {
        "httpHeaderAuth": { "id": "REEMPLAZAR_EN_N8N", "name": "P08 nucleo (X-P08-Token)" }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 }, "combinator": "and",
                "conditions": [ { "id": "c1", "leftValue": "={{ $json.status }}", "rightValue": "pendiente_aprobacion", "operator": { "type": "string", "operation": "equals" } } ] },
              "renameOutput": true, "outputKey": "Esperando clic en Aprobar"
            },
            {
              "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 }, "combinator": "and",
                "conditions": [ { "id": "c2", "leftValue": "={{ $json.status }}", "rightValue": "revision_manual", "operator": { "type": "string", "operation": "equals" } } ] },
              "renameOutput": true, "outputKey": "Revision manual"
            }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "Spam, duplicado o rechazado" }
      },
      "id": "0b1f4c0e-0004-4a00-9000-000000000004",
      "name": "Segun estado",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [740, 200]
    },
    { "parameters": {}, "id": "0b1f4c0e-0005-4a00-9000-000000000005", "name": "Aviso enviado a Telegram (nada se envia sin clic)", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1000, 60] },
    { "parameters": {}, "id": "0b1f4c0e-0006-4a00-9000-000000000006", "name": "Cola de revision manual", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1000, 200] },
    { "parameters": {}, "id": "0b1f4c0e-0007-4a00-9000-000000000007", "name": "Archivado sin accion", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1000, 340] }
  ],
  "connections": {
    "Entrada formulario o correo de prueba": { "main": [ [ { "node": "Normalizar campos", "type": "main", "index": 0 } ] ] },
    "Normalizar campos": { "main": [ [ { "node": "Nucleo P08: clasificar, borrador, tarea, aviso Telegram", "type": "main", "index": 0 } ] ] },
    "Nucleo P08: clasificar, borrador, tarea, aviso Telegram": { "main": [ [ { "node": "Segun estado", "type": "main", "index": 0 } ] ] },
    "Segun estado": { "main": [
      [ { "node": "Aviso enviado a Telegram (nada se envia sin clic)", "type": "main", "index": 0 } ],
      [ { "node": "Cola de revision manual", "type": "main", "index": 0 } ],
      [ { "node": "Archivado sin accion", "type": "main", "index": 0 } ]
    ] }
  },
  "settings": { "executionOrder": "v1", "saveDataSuccessExecution": "none", "saveDataErrorExecution": "none", "saveManualExecutions": false },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false },
  "tags": []
}
